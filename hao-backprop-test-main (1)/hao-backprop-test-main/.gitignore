# Dependencies (installed locally with `npm install --no-save`; not declared in package.json)
node_modules/

# Test and coverage output (jest coverageDirectory and the jest-junit reporter)
coverage/

# Local environment overrides loaded by src/backend/config.js via dotenv
.env
.env.local

# Runtime logs
*.log
npm-debug.log*

# Launcher runtime artifacts written by infrastructure/scripts/start-server.sh
# into the working tree: logs/server-<PORT>.pid, logs/server-<PORT>.log and
# logs/start-server.log. None of them is a source artifact, so a detached launch
# must not leave anything for `git add -A` to commit.
logs/
*.pid
